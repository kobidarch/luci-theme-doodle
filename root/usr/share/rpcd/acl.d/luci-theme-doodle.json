{
    "luci-theme-doodle": {
        "description": "Grant access for luci-theme-doodle",
        "read": {
            "uci": [ "doodle" ],
            "file": {
                "/www/luci-static/doodle/background/*": [ "list", "read" ],
                "/tmp/doodle-bg-upload": [ "read" ]
            },
            "ubus": {
                "network.interface": [ "dump" ],
                "network.device": [ "status" ]
            }
        },
        "write": {
            "uci": [ "doodle" ],
            "file": {
                "/www/luci-static/doodle/background/*": [ "write" ],
                "/tmp/doodle-bg-upload": [ "write" ],
                "/bin/mv *": [ "exec" ]
            }
        }
    }
}
