{#
  luci-theme-doodle — Main page header template
  Pastel doodle theme for LuCI. Light only. Opaque paper, ink borders.
-#}

{%
  import { readfile, access } from 'fs';
  import { cursor } from 'uci';
  import { getuid, getspnam } from 'luci.core';

  const doodle_version = trim(readfile('/usr/share/ucode/luci/template/themes/doodle/version')) ?? '?';
  const boardinfo = ubus.call('system', 'board');
  const hostname = striptags(boardinfo?.hostname ?? 'OpenWrt');

  http.prepare_content('text/html; charset=UTF-8');

  /* Read theme config (light only: font size + accent + brand) */
  let doodle_primary = '#ff8fac';
  let doodle_font_size = '14';
  let doodle_device_name = '';

  let cfg = cursor();
  if (access('/etc/config/doodle')) {
    doodle_primary     = cfg.get_first('doodle', 'global', 'primary')     ?? doodle_primary;
    doodle_font_size   = cfg.get_first('doodle', 'global', 'font_size')   ?? doodle_font_size;
    doodle_device_name = trim(cfg.get_first('doodle', 'global', 'device_name') ?? '') ?? '';
  }

  /* Display brand: custom device name wins, else system hostname. */
  const display_name = (doodle_device_name != '') ? striptags(doodle_device_name) : hostname;

  /* Custom backdrop: first existing bg.* wins (img preferred, then video).
     Previously documented but never rendered — #bg-wrap stayed empty. */
  let doodle_bg_img = null;
  let doodle_bg_vid = null;
  let doodle_img_exts = ['jpg', 'jpeg', 'png', 'webp', 'gif'];
  for (let bi = 0; bi < length(doodle_img_exts); bi++) {
    let ext = doodle_img_exts[bi];
    if (access('/www/luci-static/doodle/background/bg.' + ext)) {
      doodle_bg_img = 'bg.' + ext;
      break;
    }
  }
  if (!doodle_bg_img) {
    let doodle_vid_exts = ['mp4', 'webm'];
    for (let vi = 0; vi < length(doodle_vid_exts); vi++) {
      let vext = doodle_vid_exts[vi];
      if (access('/www/luci-static/doodle/background/bg.' + vext)) {
        doodle_bg_vid = 'bg.' + vext;
        break;
      }
    }
  }
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#fdf6ee">
  <title>{{ display_name }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>
  <link rel="icon" href="{{ media }}/img/doodle-logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ media }}/css/cascade.css">
  {% if (access('/etc/config/doodle')): %}
  <style>
    html {
      font-size: {{ doodle_font_size }}px;
    }
    /* body is 1rem so the px above is the true base size (previously
       0.875rem double-scaled: 14px setting rendered 12.25px). Primary
       fans out to every accent consumer incl. checkbox/spinner/focus
       ring — previously only --color-primary was set while components
       read --pink-deep/--sky/etc, so the picker appeared dead. */
    :root {
      --color-primary: {{ doodle_primary }};
      --pink-deep: {{ doodle_primary }};
      --color-primary-hover: color-mix(in srgb, {{ doodle_primary }} 85%, black);
      --color-primary-active: color-mix(in srgb, {{ doodle_primary }} 70%, black);
    }
  </style>
  {% endif %}
  {% if (node?.css): %}
  <link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
  {% endif %}
  {% if (css): %}
  <style>{{ css }}</style>
  {% endif %}
  <script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
  <script src="{{ resource }}/cbi.js"></script>
</head>
<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

<div id="bg-wrap">{% if (doodle_bg_img): %}<img src="{{ media }}/background/{{ doodle_bg_img }}" alt="">{% endif %}{% if (doodle_bg_vid): %}<video src="{{ media }}/background/{{ doodle_bg_vid }}" autoplay muted loop playsinline></video>{% endif %}</div>

{% if (!blank_page): %}
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside id="sidebar">
  <div class="sidebar-header">
    <span class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" style="width:1.3em;height:1.3em"><path d="M4 9c4-4 12-4 16 0"/><path d="M7 13c2.5-2.5 7.5-2.5 10 0"/><circle cx="12" cy="18" r="1.6" fill="currentColor" stroke="none"/></svg></span>
    <span class="brand">{{ display_name }}</span>
  </div>

  <nav class="sidebar-nav" id="sidebar-nav">
    <div class="nav-loading">Loading menu…</div>
  </nav>

  <div class="sidebar-footer">
    <span class="sidebar-version">DoodleTheme v{{ doodle_version }}</span>
  </div>
</aside>

<header id="header">
  <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <nav id="header-nav">
    <span class="header-title" id="header-title"></span>
  </nav>
  <div id="header-tabs"></div>

  <div id="status-indicators"></div>

  <div class="header-actions" id="indicators"></div>
</header>

<nav id="header-sub"></nav>

<main id="content-wrap">
  <div id="content">
    <div id="maincontent">
      {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
      <div class="alert-message warning">
        <h4>{{ _('No password set!') }}</h4>
        <p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
        {% if (dispatcher.lookup("admin/system/admin")): %}
        <div class="right"><a class="btn cbi-button-positive" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
        {% endif %}
      </div>
      {% endif %}

      <noscript>
        <div class="alert-message warning">
          <h4>{{ _('JavaScript required!') }}</h4>
          <p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
        </div>
      </noscript>
{% endif %}
